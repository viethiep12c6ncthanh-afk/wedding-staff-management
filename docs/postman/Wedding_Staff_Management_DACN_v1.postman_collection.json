{
  "info": {
    "name": "Wedding Staff Management — DACN v1",
    "_postman_id": "8c742f9f-dacn-4f18-9a33-weddingstaffv1",
    "description": "Demo/release collection. No real credentials or secrets are embedded. Set collection variables locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "employeeUsername",
      "value": ""
    },
    {
      "key": "employeePassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "from",
      "value": "2026-09-01"
    },
    {
      "key": "to",
      "value": "2026-09-30"
    },
    {
      "key": "requestId",
      "value": "1"
    },
    {
      "key": "shiftId",
      "value": "1"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "qrToken",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set(\"adminToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{employeeUsername}}\",\"password\":\"{{employeePassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set(\"employeeToken\", json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dashboard & Reports",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/summary",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Operations analytics",
          "request": {
            "method": "GET",

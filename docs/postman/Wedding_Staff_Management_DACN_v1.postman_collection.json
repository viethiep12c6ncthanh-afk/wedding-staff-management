            "body": {
              "mode": "raw",
              "raw": "{\"shiftId\":{{shiftId}},\"action\":\"CHECK_IN\",\"validMinutes\":10,\"latitude\":10.7769,\"longitude\":null,\"radiusMeters\":null}",
              "options": {

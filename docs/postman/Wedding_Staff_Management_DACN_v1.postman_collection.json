    },
    {
      "name": "Replacement Recommendation",
      "item": [
        {
          "name": "Deterministic candidates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/replacements/requests/{{requestId}}/candidates",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "AI-assisted recommendation",
          "request": {
            "method": "POST",
            "header": [],

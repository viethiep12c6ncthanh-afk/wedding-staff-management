# File minh họa. Không đặt bí mật thật vào file này.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/wedding_staff_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=replace_with_local_mysql_password

JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_EXPIRATION_MS=86400000

JPA_DDL_AUTO=validate
SERVER_PORT=8080

# Chỉ bật trên máy demo/dev. Khi bật, QR/OTP không phụ thuộc giờ thật của ca.
# Các kiểm tra phân công, hạn phiên, GPS và chống thao tác trùng vẫn giữ nguyên.
ATTENDANCE_DEMO_ENABLED=true

# Chỉ bật khi cần tạo dữ liệu mẫu trên database mới.
SEED_ENABLED=false
SEED_ADMIN_PASSWORD=replace_when_seed_enabled
SEED_COORDINATOR_PASSWORD=replace_when_seed_enabled
SEED_EMPLOYEE_PASSWORD=replace_when_seed_enabled

# AI hỗ trợ gợi ý nhân sự. Mặc định dùng Ollama local khi bật AI.
# Không commit API key thật. Với OLLAMA không cần API key.
AI_ENABLED=true
AI_PROVIDER=OLLAMA
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL=qwen3:4b-instruct
AI_TIMEOUT_MS=60000
AI_CANDIDATE_LIMIT=5
AI_RECENT_EVALUATION_LIMIT=3

# Nếu cần dùng OpenAI thay cho Ollama:
# AI_PROVIDER=OPENAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=replace_with_openai_api_key
# AI_MODEL=gpt-5.4-mini
